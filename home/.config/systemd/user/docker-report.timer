[Unit]
Description=Report Docker disk usage weekly
Documentation=file:%h/.local/bin/docker-report.sh

[Timer]
# Every Monday at 09:00 local time — start of the week, so stale volumes from
# finished projects surface before the disk fills.
OnCalendar=Mon *-*-* 09:00:00
# If the machine was off at 09:00, run at next boot/login instead of skipping.
Persistent=true
# Spread the start to avoid a thundering herd on shared hosts.
RandomizedDelaySec=10min

[Install]
WantedBy=timers.target
